# Local-only example for the hosted MCP OAuth callback/frontdoor flow.
# Do not reuse these static keys outside localhost testing.

TP_BASE_URL=https://example.tpondemand.com
FRONTDOOR_URL=https://frontdoor-eu.apptio.com

MCP_PORT=3000
MCP_PUBLIC_URL=http://localhost:3000
MCP_REQUIRE_HTTPS=0
MCP_SIGNING_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TP_TOKEN_ENCRYPTION_KEY_B64=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
TP_TOKEN_STORE_PATH=/tmp/targetprocess-mcp-local-credentials.json

MCP_OAUTH_CLIENTS_JSON='[{"client_id":"local-claude-org","name":"Local Claude org connector smoke test","redirect_uris":["http://localhost:3333/callback"],"allowed_origins":["http://localhost:3333","https://claude.ai"],"scopes":["mcp:tools"]}]'

OIDC_ISSUER_URL=http://localhost:48080
OIDC_CLIENT_ID=local-targetprocess-mcp
OIDC_CLIENT_SECRET=local-dev-secret
OIDC_AUTHORIZATION_ENDPOINT=http://localhost:48080/authorize
OIDC_TOKEN_ENDPOINT=http://localhost:48080/token
OIDC_JWKS_URI=http://localhost:48080/jwks
OIDC_SCOPES=openid,email,profile

# Keep empty for the mock provider. Set this to your company email domain in production.
OIDC_ALLOWED_DOMAINS=
